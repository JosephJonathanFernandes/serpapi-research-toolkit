# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: your SerpApi API key (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Optional: override the default cache directory (default: ~/.serpapi_cache)
# SERPAPI_CACHE_DIR=/tmp/serpapi_cache

# Optional: cache TTL in seconds (default: 86400 = 24h). Set to 0 to disable.
# SERPAPI_CACHE_TTL=86400
